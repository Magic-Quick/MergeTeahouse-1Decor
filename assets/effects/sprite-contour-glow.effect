// Свечение по контуру. Padding на ноде (как IconOutline) + UV remap; радиус в texel (как outline-sprite-v5).
CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one
          blendSrcAlpha: src_alpha
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        glowColor: { value: [1.0, 0.84, 0.28, 1.0], editor: { type: color, displayName: Glow Color } }
        textureSize: { value: [256.0, 256.0], editor: { displayName: Texture Size } }
        glowRadius: { value: 8.0, editor: { slide: true, range: [1.0, 32.0], step: 0.5, displayName: Glow Radius (texels) } }
        glowIntensity: { value: 1.2, editor: { slide: true, range: [0, 3], step: 0.01, displayName: Glow Intensity } }
        glowSoftness: { value: 0.65, editor: { slide: true, range: [0, 1], step: 0.01, displayName: Glow Softness } }
        contentScaleX: { value: 1.0, editor: { slide: true, range: [0.5, 1.0], step: 0.01, displayName: Content Scale X } }
        contentScaleY: { value: 1.0, editor: { slide: true, range: [0.5, 1.0], step: 0.01, displayName: Content Scale Y } }
}%

CCProgram vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if USE_TEXTURE
    in vec2 a_texCoord;
    out mediump vec2 v_uv0;
  #endif
  in vec3 a_position;
  in vec4 a_color;

  out vec4 v_color;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    #if USE_TEXTURE
      v_uv0 = a_texCoord;
    #endif
    v_color = a_color;
    return pos;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 v_color;
  #if USE_TEXTURE
    in mediump vec2 v_uv0;
  #endif

  uniform Constant {
    vec4 glowColor;
    vec2 textureSize;
    float glowRadius;
    float glowIntensity;
    float glowSoftness;
    float contentScaleX;
    float contentScaleY;
  };

  #pragma builtin(local)
  layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;

  vec2 toSpriteUv(vec2 quadUv) {
    return (quadUv - 0.5) / vec2(contentScaleX, contentScaleY) + 0.5;
  }

  float sampleAlphaAtQuad(vec2 quadUv) {
    vec2 uv = toSpriteUv(quadUv);
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
      return 0.0;
    }
    return CCSampleWithAlphaSeparated(cc_spriteTexture, uv).a * v_color.a;
  }

  float blurredAlpha(vec2 quadUv) {
    float accum = 0.0;
    float weightSum = 0.0;
    vec2 texel = 1.0 / textureSize;
    vec2 quadTexel = texel * vec2(contentScaleX, contentScaleY);

    const int RINGS = 6;
    const int ANGLES = 16;

    for (int ring = 1; ring <= RINGS; ring++) {
      float ringT = float(ring) / float(RINGS);
      float ringWeight = mix(1.0, glowSoftness, ringT);
      float radius = glowRadius * ringT;

      for (int angle = 0; angle < ANGLES; angle++) {
        float a = float(angle) * 6.28318530718 / float(ANGLES);
        vec2 offset = vec2(cos(a), sin(a)) * radius;
        vec2 sampleQuadUv = quadUv + offset * quadTexel;
        accum += sampleAlphaAtQuad(sampleQuadUv) * ringWeight;
        weightSum += ringWeight;
      }
    }

    return weightSum > 0.0 ? accum / weightSum : 0.0;
  }

  vec4 frag () {
    #if USE_TEXTURE
      float inside = sampleAlphaAtQuad(v_uv0);
      float blur = blurredAlpha(v_uv0);
      float halo = max(blur - inside * 0.85, 0.0);
      halo = pow(halo, 0.75);
      float alpha = halo * glowColor.a * glowIntensity * v_color.a;
      return vec4(glowColor.rgb, alpha);
    #else
      return vec4(glowColor.rgb, glowColor.a * v_color.a);
    #endif
  }
}%
